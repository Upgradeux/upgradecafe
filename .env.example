# Database (Supabase PostgreSQL with Drizzle ORM)
DATABASE_URL="postgres://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Authentication (Better Auth)
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Redis (Upstash Redis for Distributed Rate Limiting)
UPSTASH_REDIS_REST_URL="https://[YOUR-UPSTASH-PROJECT].upstash.io"
UPSTASH_REDIS_REST_TOKEN="[YOUR-UPSTASH-REST-TOKEN]"

# Cloudflare R2 Storage (S3 API Presigned Uploads)
R2_ACCOUNT_ID="[YOUR-CLOUDFLARE-ACCOUNT-ID]"
R2_ACCESS_KEY_ID="[YOUR-R2-ACCESS-KEY-ID]"
R2_SECRET_ACCESS_KEY="[YOUR-R2-SECRET-ACCESS-KEY]"
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

# Email verification (configure SMTP or Resend)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
RESEND_API_KEY=""
RESEND_FROM=""

# Firebase Phone Authentication (10,000 free SMS/month)
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# Initial Super Admin (required for npm run db:seed)
SUPER_ADMIN_EMAIL=""
SUPER_ADMIN_PASSWORD=""

# Optional Google OAuth credentials; leave blank until configured.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Better Auth Infrastructure integration (optional; enter project values to connect Dash).
BETTER_AUTH_API_KEY=""
BETTER_AUTH_API_URL=""
BETTER_AUTH_KV_URL=""
NEXT_PUBLIC_BETTER_AUTH_KV_URL=""
